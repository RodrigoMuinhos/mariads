{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tatuadora-fortaleza",
      "destination": "/tatuadora-fortaleza/index.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade/index.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/estilos",
      "destination": "/estilos/index.html"
    },
    {
      "source": "/flash-desenhos",
      "destination": "/flash-desenhos/index.html"
    },
    {
      "source": "/projetos-grande-escala",
      "destination": "/projetos-grande-escala/index.html"
    },
    {
      "source": "/como-funciona",
      "destination": "/como-funciona/index.html"
    },
    {
      "source": "/duvidas",
      "destination": "/duvidas/index.html"
    },
    {
      "source": "/cuidados",
      "destination": "/cuidados/index.html"
    },
    {
      "source": "/depoimentos",
      "destination": "/depoimentos/index.html"
    },
    {
      "source": "/orcamento",
      "destination": "/orcamento/index.html"
    },
    {
      "source": "/instagram",
      "destination": "/instagram/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
